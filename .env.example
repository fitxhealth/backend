# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database & Security
MONGO_URI=your_fitxhealth_mongodb_connection_string
JWT_SECRET=your_fitxhealth_jwt_secret
ADMIN_EMAILS=admin@fitxhealth.com

# Cloudinary (FitX Health Account)
CLOUDINARY_CLOUD_NAME=your_fitxhealth_cloud_name
CLOUDINARY_API_KEY=your_fitxhealth_api_key
CLOUDINARY_API_SECRET=your_fitxhealth_api_secret

# Email Service
RESEND_API_KEY=re_your_fitxhealth_resend_api_key
RESEND_FROM_EMAIL=FitX Health <noreply@fitxhealth.com>