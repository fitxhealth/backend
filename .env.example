# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# Database & Security (Replace these with real values in your actual .env file)
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_EMAILS=admin1@example.com,admin2@example.com

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments (disabled by default)
ENABLE_RAZORPAY=false
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── OTP Providers ─────────────────────────────────────────────────────────────

# Email OTP via Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Living Result <noreply@getlivingresult.in>

# Phone OTP via MSG91 (https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=LVRST
MSG91_TEMPLATE_ID=your_msg91_template_id

# ── Rewards System ────────────────────────────────────────────────────────────
# Set to 'true' to activate reward point earning (currently off — Coming Soon)
REWARDS_ENABLED=false